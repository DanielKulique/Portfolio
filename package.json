{
  "name": "daniel-kulique-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/security.mjs",
    "preview": "astro preview",
    "check": "astro check && vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "playwright test",
    "test:links": "node scripts/validate-links.mjs",
    "validate": "npm run check && npm run lint && npm run format:check && npm run test:unit && npm run build && npm run test:links && npm test",
    "audit:performance": "node scripts/lighthouse.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --experimental-strip-types --test tests/algorithms.test.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@astrojs/vue": "7.1.6",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@lucide/astro": "1.77.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "tailwindcss": "4.3.5",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-vue": "10.12.1",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
