---
// English routes use the same allowlist and the matching translated study.
import { getCollection } from 'astro:content';
import CaseStudy from '../../../components/sections/CaseStudy.astro';
export async function getStaticPaths() {
  return (await getCollection('projects', ({ data }) => !data.draft)).map(
    (project) => ({ params: { slug: project.data.slug }, props: { project } }),
  );
}
const { project } = Astro.props;
---

<CaseStudy project={project} locale="en" />
