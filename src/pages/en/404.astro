---
// Nested Cloudflare fallback preserves the visitor's language for missing English routes.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  locale="en"
  title="Page not found — Daniel Kulique"
  description="This address does not exist. Explore Daniel Kulique’s projects."
  alternate="/"
  noindex
>
  <section class="shell error-page">
    <p class="eyebrow">404 / ROUTE NOT FOUND</p>
    <h1>
      This route does
      <br />
      not exist yet.
    </h1>
    <p>The address may have changed. The projects are still here.</p>
    <a class="button primary" href="/en/">
      Back to home
    </a>
    <a class="text-link" href="/" lang="pt-BR">
      Ir para a página em português
    </a>
  </section>
</BaseLayout>
