---
/** Factual background, seven evidence-linked capability areas, research training and authorized contact actions. */
import {
  GraduationCap,
  FlaskConical,
  Layers,
  CodeXml,
  Database,
  Cpu,
  Server,
  Wrench,
  Monitor,
} from '@lucide/astro';
import { getCollection } from 'astro:content';
import { copy, projectPath, type Locale } from '../../i18n';
import { profile } from '../../data/profile';
import { technologyGroups } from '../../data/technologies';
import ProfessionalLinks from '../ui/ProfessionalLinks.astro';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale],
  en = locale === 'en';
const projects = await getCollection('projects', ({ data }) => !data.draft);
const titles = new Map(
  projects.map((p) => [p.data.slug, p.data.content[locale].title]),
);
const icons = [CodeXml, Server, Monitor, Database, Cpu, Layers, Wrench];
const levels = {
  demonstrated: en
    ? 'Demonstrated in public artifacts'
    : 'Demonstrado em artefatos públicos',
  academic: en
    ? 'Reported academic knowledge'
    : 'Conhecimento acadêmico informado',
  reported: en
    ? 'Owner-reported use in a private project'
    : 'Uso informado em projeto privado',
  learning: en
    ? 'Learning and research training'
    : 'Aprendizagem e formação em pesquisa',
};
---

<section class="section about-section" id="about" aria-labelledby="about-title">
  <div class="shell about-grid">
    <div>
      <p class="eyebrow">{t.about.toUpperCase()}</p>
      <h2 id="about-title" class="multiline">
        {t.aboutTitle}
      </h2>
      <p class="about-copy">{t.aboutText}</p>
      <p class="about-copy">{t.aboutMore}</p>
    </div>
    <div class="about-notes">
      <article>
        <GraduationCap size={24} aria-hidden="true" />
        <p class="mono">{t.academic}</p>
        <h3>{t.degree}</h3>
        <p>
          {profile.education}
          <br />
          Campus {profile.campus}
        </p>
      </article>
      <article>
        <FlaskConical size={24} aria-hidden="true" />
        <p class="mono">{t.interests}</p>
        <p>{t.interestText}</p>
      </article>
    </div>
  </div>
</section>
<section class="section shell" id="stack" aria-labelledby="stack-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">
        {en ? 'TECHNOLOGIES & PRACTICE' : 'TECNOLOGIAS E PRÁTICA'}
      </p>
      <h2 id="stack-title">{t.stackTitle}</h2>
    </div>
    <p class="section-description">
      {en
        ? 'Follow each technology to the project that demonstrates its use. Academic knowledge and ongoing study are identified separately.'
        : 'Da tecnologia ao projeto que demonstra sua utilização. Conhecimentos acadêmicos e estudos em andamento são identificados separadamente.'}
    </p>
  </div>
  <div class="tech-grid">
    {technologyGroups.map((group, index) => {
      const Icon = icons[index]!;
      return (
        <article class="tech-card">
          <Icon size={21} aria-hidden="true" />
          <h3>{group.title[locale]}</h3>
          <ul class="tech-evidence">
            {group.items.map((item) => (
              <li>
                <strong>{item.name}</strong>
                {item.focus && (
                  <span class="tech-level">{item.focus[locale]}</span>
                )}
                {item.level !== 'demonstrated' && (
                  <span class="tech-level">{levels[item.level]}</span>
                )}
                {item.projects
                  .filter((slug) => titles.has(slug))
                  .map((slug) => (
                    <a href={projectPath(slug, locale)}>{titles.get(slug)}</a>
                  ))}
              </li>
            ))}
          </ul>
        </article>
      );
    })}
  </div>
</section>
<section class="section shell" id="research" aria-labelledby="research-title">
  <div class="research-panel">
    <div class="research-symbol" aria-hidden="true">
      <FlaskConical size={48} />
      <span class="mono">
        NLP · EMBEDDINGS
        <br />
        {en ? 'VECTOR SEARCH' : 'BUSCA VETORIAL'}
      </span>
    </div>
    <div>
      <p class="eyebrow">
        {en ? 'UNDERGRADUATE RESEARCH' : 'INICIAÇÃO CIENTÍFICA'} · UTFPR
      </p>
      <h2 id="research-title">{t.researchTitle}</h2>
      <p>{t.researchText}</p>
    </div>
  </div>
</section>
<section class="section shell" id="contact" aria-labelledby="contact-title">
  <div class="contact-panel">
    <div>
      <p class="eyebrow">{t.contact.toUpperCase()}</p>
      <h2 id="contact-title" class="multiline">
        {t.contactTitle}
      </h2>
    </div>
    <div>
      <p>
        {en
          ? 'Open to internships and junior roles in back-end development, software engineering and applied AI. Let’s talk about systems, data and research.'
          : 'Disponível para estágio e posições júnior em desenvolvimento back-end, engenharia de software e IA aplicada. Vamos conversar sobre sistemas, dados e pesquisa.'}
      </p>
      <ProfessionalLinks locale={locale} />
    </div>
  </div>
</section>
