---
/** Complete bilingual technical study; public sources are pinned to inspected repository revisions. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { GitFork, FolderGit2 } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemDiagram from '../interactive/SystemDiagram.vue';
import ProjectVisual from '../ui/ProjectVisual.astro';
import acoImage from '../../assets/aco-original.png';
import { copy, projectPath, home, type Locale } from '../../i18n';
interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}
const {
  project: { data: p },
  locale,
} = Astro.props;
const c = p.content[locale];
const t = copy[locale];
const fields = Object.keys(t.fields) as Array<keyof typeof t.fields>;
---

<BaseLayout
  locale={locale}
  title={`${c.title} — Daniel Kulique`}
  description={c.summary}
  alternate={projectPath(p.slug, locale === 'en' ? 'pt-BR' : 'en')}
>
  <article class="case-study shell">
    <a class="text-link back-link" href={`${home(locale)}#projects`}>
      <FolderGit2 size={18} aria-hidden="true" />
      {t.back}
    </a>
    <p class="eyebrow">
      {t.study} · {p.categories.map((cat) => t.category[cat]).join(' / ')}
    </p>
    <h1>{c.title}</h1>
    <p class="case-lead">{c.summary}</p>
    <dl class="case-meta">
      <div>
        <dt>{t.context}</dt>
        <dd>{c.context}</dd>
      </div>
      <div>
        <dt>{t.status}</dt>
        <dd>{c.status}</dd>
      </div>
      <div>
        <dt>{t.technologies}</dt>
        <dd>{p.technologies.join(' · ')}</dd>
      </div>
    </dl>
    {p.visual === 'network' ? (
      <div class="case-diagram">
        <h2>{t.diagramTitle}</h2>
        <p>{t.diagramNote}</p>
        <SystemDiagram locale={locale} client:visible />
      </div>
    ) : (
      <ProjectVisual kind={p.visual} label={t.sketch} />
    )}
    <div class="case-content">
      <aside
        aria-label={locale === 'en' ? 'Study contents' : 'Conteúdo do estudo'}
      >
        {fields.map((key) => (
          <a href={`#${key}`}>{t.fields[key]}</a>
        ))}
      </aside>
      <div>
        {fields.map((key) => (
          <section id={key} class="case-section">
            <h2>{t.fields[key]}</h2>
            <p>{c[key]}</p>
          </section>
        ))}
      </div>
    </div>
    {p.visual === 'graph' && (
      <figure class="case-image">
        <Image
          src={acoImage}
          alt={
            locale === 'en'
              ? 'Original public ACO application screenshot showing a weighted graph and algorithm controls.'
              : 'Captura pública original da aplicação ACO com grafo ponderado e controles do algoritmo.'
          }
          widths={[480, 800, 1200]}
          sizes="(max-width: 800px) 100vw, 800px"
          format="webp"
          loading="lazy"
        />
        <figcaption>
          {locale === 'en'
            ? 'Original screenshot from the public repository. No interactive application runs on this page.'
            : 'Captura original do repositório público. A aplicação não é executada nesta página.'}
        </figcaption>
      </figure>
    )}
    <section class="case-sources">
      <h2>{t.sources}</h2>
      {p.sources.map((source) => (
        <a href={source.url} class="button secondary">
          <GitFork size={18} aria-hidden="true" />
          {source.label}
        </a>
      ))}
    </section>
  </article>
</BaseLayout>
