---
/** Professional case structure combines domain context, implementation, evidence, execution and immutable sources. */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemDiagram from '../interactive/SystemDiagram.vue';
import ProjectEvidence from '../ui/ProjectEvidence.astro';
import { copy, home, projectPath, type Locale } from '../../i18n';
interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}
const {
  project: { data: p },
  locale,
} = Astro.props;
const c = p.content[locale],
  t = copy[locale];
const fields = Object.keys(t.fields) as Array<keyof typeof t.fields>;
const evidenceTitle =
  locale === 'en'
    ? 'Visual and technical evidence'
    : 'Evidências visuais e técnicas';
const runTitle = locale === 'en' ? 'How to run' : 'Como executar';
---

<BaseLayout
  locale={locale}
  title={`${c.title} — Daniel Kulique`}
  description={c.summary}
  alternate={projectPath(p.slug, locale === 'en' ? 'pt-BR' : 'en')}
>
  <article class="case-study shell">
    <a class="text-link back-link" href={`${home(locale)}#projects`}>
      {t.back}
    </a>
    <p class="eyebrow">
      {t.study} ·{' '}
      {p.categories.map((category) => t.category[category]).join(' / ')}
    </p>
    <h1>{c.title}</h1>
    {c.subtitle && <p class="case-subtitle">{c.subtitle}</p>}
    <p class="case-lead">{c.summary}</p>
    <dl class="case-meta">
      <div>
        <dt>{t.context}</dt>
        <dd>{c.context}</dd>
      </div>
      <div>
        <dt>{t.status}</dt>
        <dd>{c.status}</dd>
      </div>
      <div>
        <dt>{t.technologies}</dt>
        <dd>{p.technologies.join(' · ')}</dd>
      </div>
    </dl>
    <div class="case-content">
      <aside
        aria-label={locale === 'en' ? 'Study contents' : 'Conteúdo do estudo'}
      >
        {fields.map((key) => (
          <a href={`#${key}`}>{t.fields[key]}</a>
        ))}
        {p.evidence && <a href="#evidence">{evidenceTitle}</a>}
        {c.execution && <a href="#execution">{runTitle}</a>}
      </aside>
      <div>
        {fields.map((key) => (
          <>
            <section id={key} class="case-section">
              <h2>{t.fields[key]}</h2>
              <p>{c[key]}</p>
            </section>
            {key === 'architecture' &&
              p.visual === 'network' &&
              p.slug === 'sistemas-distribuidos' && (
                <div class="case-diagram">
                  <h3>{t.diagramTitle}</h3>
                  <p>{t.diagramNote}</p>
                  <SystemDiagram locale={locale} client:visible />
                </div>
              )}
            {key === 'challenges' && p.evidence && (
              <section id="evidence" class="case-section">
                <h2>{evidenceTitle}</h2>
                <ProjectEvidence evidence={p.evidence} locale={locale} />
                {p.slug === 'masmorra-2d' && (
                  <a class="button primary" href={`${home(locale)}lab/`}>
                    {locale === 'en'
                      ? 'Try the independent A* demo'
                      : 'Experimentar a demonstração independente de A*'}
                  </a>
                )}
              </section>
            )}
          </>
        ))}
        {c.execution && (
          <section id="execution" class="case-section execution-steps">
            <h2>{runTitle}</h2>
            <p>{c.execution.requirements}</p>
            <pre><code>{c.execution.commands}</code></pre>
            <p>{c.execution.note}</p>
          </section>
        )}
      </div>
    </div>
    <section class="case-sources">
      <h2>{t.sources}</h2>
      {p.sources.map((source) => (
        <a class="text-link" href={source.url}>
          {source.label}
        </a>
      ))}
      {p.repository && (
        <p>
          <a class="button secondary" href={p.repository}>
            {t.repo}
          </a>
        </p>
      )}
    </section>
  </article>
</BaseLayout>
