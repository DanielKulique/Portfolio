---
/** Semantic document shell, local fonts and metadata; absolute URLs require a confirmed origin. */
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { copy, type Locale } from '../i18n';
interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternate: string;
  noindex?: boolean;
}
const { locale, title, description, alternate, noindex = false } = Astro.props;
const canonical =
  Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const other = Astro.site ? new URL(alternate, Astro.site) : alternate;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b1120" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {!noindex && canonical && (
      <>
        <link
          rel="alternate"
          hreflang={locale}
          href={canonical ?? Astro.url.pathname}
        />
        <link
          rel="alternate"
          hreflang={locale === 'en' ? 'pt-BR' : 'en'}
          href={other}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={locale === 'en' ? other : (canonical ?? Astro.url.pathname)}
        />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'pt_BR'} />
    <meta property="og:site_name" content="Daniel Kulique" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.site && (
      <>
        <meta
          property="og:image"
          content={new URL('/images/social-card.png', Astro.site)}
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
          property="og:image:alt"
          content="Daniel Kulique — Software. Systems. Applied AI."
        />
      </>
    )}
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy[locale].skip}
    </a>
    <Header locale={locale} alternate={alternate} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
